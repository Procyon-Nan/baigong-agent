# Infrastructure configuration only. Model-provider credentials are configured in the admin UI.
DATABASE_URL=postgresql://baigong:baigong@127.0.0.1:5432/baigong_agent
# Required only by P2 database and HTTP acceptance tests. Must name a separate database.
P2_TEST_DATABASE_URL=postgresql://baigong:baigong@127.0.0.1:5432/baigong_agent_p2_test
# Required only by P3 database and HTTP acceptance tests. Must name a separate database.
P3_TEST_DATABASE_URL=postgresql://baigong:baigong@127.0.0.1:5432/baigong_agent_p3_test
# Required only by P4 database and HTTP acceptance tests. Must end with _p4_test.
P4_TEST_DATABASE_URL=postgresql://baigong:baigong@127.0.0.1:5432/baigong_agent_p4_test
BAIGONG_APP_ORIGIN=http://localhost:3000
# Development default. Production deployments must use an absolute path on a native Linux filesystem.
BAIGONG_DATA_DIR=.data
